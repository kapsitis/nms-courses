# 7.AMO. temats "Svēršanas uzdevumi": garais kandidātu saraksts.
#
# Meklējam uzdevumus, kuros jāapraksta PROCEDŪRA, kas ar sviras svariem (vai
# citu informācijas avotu) garantēti noskaidro kaut ko par nezināmiem
# priekšmetiem. Temats atbilst curriculum_7_8.md 9. tematam "Svēršanas un
# algoritmi: Kā uzzināt vairāk ar mazāk jautājumiem".
#
# Birku slānis šim tematam ir gandrīz tukšs: visā krātuvē nav nevienas birkas
# ar "Weigh", "Balance" vai "Coin"; vienīgās tuvās ir jēdziens "DecisionTree"
# (30 uzdevumi), tēmas SearchProblems un ProblemsWithHiddenInformation (kopā 3
# uzdevumi) un apakšdomēns DOM_CombinatorialAlgorithms (14 uzdevumi). Ar to
# vien pietrūktu: pati svēršanas uzdevumu kodola sērija (LV.NOL.2019.7.2,
# LV.NOL.2019.8.2, LV.SOL.2020.9.3 u.c.) nav apbirkota nemaz. Tāpēc vaicājumam
# ir divi zari:
#
#   (A) TEKSTA zars - svēršanas uzdevumi pēc formulējuma. Latviešu olimpiāžu
#       tekstos šis žanrs ir ļoti stabili formulēts: "svēršan", "sviras svari",
#       "sviru svari", "atsvar". Vienīgā viltus sakritība ir vārds "īpatsvars"
#       (LV.NOL.2017.6.5 par liepām un ozoliem), ko izslēdzam atsevišķi.
#
#   (B) BIRKU zars - radniecīgie "cik informācijas dod viens jautājums"
#       uzdevumi BEZ svariem (mēģenes ar reaģentiem, minēšana ar jautājumiem,
#       pārbaudes ierīce). Tie ir 2. nodarbības pēdējiem pakāpieniem.
#
# ?family sadala kandidātus pēc tā, KAS tieši jānoskaidro - tas ir arī abu
# nodarbību dalījums:
#   Counterfeit - atrast viltoto/atšķirīgo priekšmetu vai pateikt, vai tas ir
#                 vieglāks vai smagāks               (1. nodarbība),
#   Extremes    - atrast vieglāko/smagāko, sarindot  (2. nodarbība),
#   Weights     - atsvari ar zināmām masām, līdzsvars, bilance (abas),
#   Questions   - informācija bez svariem: jautājumi, testi, ierīces
#                                                    (2. nodarbība).
#
# Attēlus NEIZSLĒDZAM: šajā tematā zīmējums gandrīz vienmēr ir tikai sviras
# svaru ilustrācija (LV.NOL.2025.6.5), nevis uzdevuma nesējs.
#
# Izpilde:
#   python nms-courses/scripts/select_problems.py \
#          nms-courses/docs/matf78/26_27/78AMO_PREPARATION/78_weighing_problems/problems.rq

PREFIX eliozo: <http://www.dudajevagatve.lv/eliozo#>

SELECT ?problemID ?grade ?family ?diff
       (GROUP_CONCAT(DISTINCT ?domain;       separator="/") AS ?domains)
       (GROUP_CONCAT(DISTINCT ?questionType; separator="/") AS ?questionTypes)
WHERE {
  ?p a eliozo:Problem ;
     eliozo:problemID ?problemID ;
     eliozo:problemGrade ?grade ;
     eliozo:problemYear ?year ;
     eliozo:problemText ?text .
  OPTIONAL { ?p eliozo:domain ?domain }
  OPTIONAL { ?p eliozo:questionType ?questionType }
  OPTIONAL { ?p eliozo:_readingDifficulty ?diff }

  {
    # ---- (A) teksta zars: svēršanas uzdevumi ----------------------------
    # UNION zaram ir sava mainīgo telpa: ?p un ?text te jāsaista vēlreiz,
    # citādi zara iekšējie FILTER strādātu ar nesaistītiem mainīgajiem.
    ?p eliozo:problemText ?text .
    FILTER (CONTAINS(?text, "svēršan") || CONTAINS(?text, "sviras svar")
            || CONTAINS(?text, "sviru svar")
            || (CONTAINS(?text, "atsvar") && !CONTAINS(?text, "īpatsvar")))

    # Ko tieši prasa noskaidrot. Secība ir svarīga: "viltotā/atšķirīgā" ir
    # šaurāka pazīme nekā "vieglākais/smagākais" un jāpārbauda pirmā.
    BIND (
      IF (CONTAINS(?text, "viltot") || CONTAINS(?text, "atšķirīg"), "Counterfeit",
      IF (CONTAINS(?text, "vieglāko") || CONTAINS(?text, "smagāko")
          || CONTAINS(?text, "visvieglāk") || CONTAINS(?text, "vissmagāk")
          || CONTAINS(?text, "sarindot"), "Extremes",
                                          "Weights")) AS ?family )
  }
  UNION
  {
    # ---- (B) birku zars: informācija bez svariem -------------------------
    ?p eliozo:problemText ?text .
    { ?p eliozo:_hasSolutionConcept "DecisionTree" }
    UNION
    { ?p eliozo:topic ?topicIRI .
      FILTER (CONTAINS(STR(?topicIRI), "SearchProblems")
              || CONTAINS(STR(?topicIRI), "ProblemsWithHiddenInformation")) }

    # Svēršanas jau paņēma (A) zars.
    FILTER (!CONTAINS(?text, "svēršan") && !CONTAINS(?text, "sviras svar")
            && !CONTAINS(?text, "sviru svar"))
    # Vajag tieši "uzzināt ar jautājumiem", nevis jebkuru gājienu procesu:
    # bez šī filtra iekrīt lodīšu maiņas un skaitļu dzēšanas invariantu uzdevumi.
    FILTER (CONTAINS(?text, "jautājum") || CONTAINS(?text, "pārbaud")
            || CONTAINS(?text, "uzminēt") || CONTAINS(?text, "noskaidrot")
            || CONTAINS(?text, "ierīc"))
    BIND ("Questions" AS ?family)
  }

  FILTER (LANG(?text) = "" || LANGMATCHES(LANG(?text), "lv"))
  FILTER (?grade >= 5 && ?grade <= 12)   # 7.-8. klases līmenis ar lielu rezervi
  FILTER (?year >= 2003 && ?year <= 2026)
}
GROUP BY ?problemID ?grade ?family ?diff
ORDER BY ?family ?grade ?problemID
